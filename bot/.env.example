# Copie para bot/.env neste computador. Nunca envie o .env para o GitHub.
# Supabase › Project Settings › API: Project URL e a chave "service_role" (secreta: dá acesso total ao banco).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role

# Número do WhatsApp do robô (só dígitos, com 55 e DDD). Com ele, a conexão é por código de 8 letras
# (Aparelhos conectados › Conectar com número de telefone). Sem ele, aparece um QR code.
BOT_TELEFONE=

# Fechamento do dia (fuso de Cuiabá). O relatório do pátio sai ao ligar o computador, ou às RELATORIO_MANHA se ele ficou ligado.
RELATORIO_MANHA=07:30
RELATORIO_FIM=17:00
